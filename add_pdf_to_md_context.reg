Windows Registry Editor Version 5.00

; Template context menu registry registration.
; Run setup_context_menu.py or install_context_menu.bat to automatically detect
; your current python executable and repository path.

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\ConvertToMarkdown]
@="Convert to Markdown (.md)"
"Icon"="notepad.exe"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.pdf\shell\ConvertToMarkdown\command]
@="\"<PYTHONW_PATH>\" \"<SCRIPT_PATH>\" \"%1\""
